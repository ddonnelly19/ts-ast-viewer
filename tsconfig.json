{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2024",
		"lib": [
			"ES2024",
			"DOM"
		],
		"jsx": "react-jsx",
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strict": true,
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "dist",
		"typeRoots": [
			"./@types/"
		]
	},
	"exclude": [
		"node_modules",
		"**/node_modules/*"
	]
}